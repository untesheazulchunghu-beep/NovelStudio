{
  "performance": {
    "enableGPU": true,
    "maxMemoryMB": 2048,
    "threadPoolSize": 4
  },
  "logging": {
    "level": "info",
    "path": "logs/"
  },
  "ui": {
    "enableDevTools": false,
    "enableHardwareAcceleration": true
  },
  "database": {
    "path": "novelstudio.db",
    "poolSize": 5
  },
  "ai": {
    "defaultProvider": "openai",
    "defaultModel": "gpt-3.5-turbo",
    "temperature": 0.7,
    "maxTokens": 4096
  }
}
